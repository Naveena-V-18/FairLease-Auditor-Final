{
  "buildCommand": "npm run build",
  "installCommand": "npm install && cd api && pip install -r requirements.txt",
  "framework": "nextjs",
  "functions": {
    "api/main.py": {
      "runtime": "@vercel/python@4.3.1",
      "memory": 3008,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
